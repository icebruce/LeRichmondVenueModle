# Cloud saving (step 2). Set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.
APP_PASSWORD=choose-a-shared-password
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Added automatically by the Upstash Redis integration (Vercel Marketplace, free plan):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Custom model requests (step 3): lets Claude read requests and their photos, never change them.
# 24+ random characters; also give it to the Claude environment that builds the requests.
LIBRARY_REQUESTS_TOKEN=
